#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 022

ROOT="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
DATA_ROOT="$DATA_HOME/hltv-demos"
AGENTS=()
BIN_LINK=1
WITH_MCP=0
LOCK=""
RELEASE=""

usage() {
  cat <<'EOF'
Usage: ./scripts/install [--agent NAME]... [--prefix ABSOLUTE_PATH] [--with-mcp] [--no-bin-link]

NAME: auto, all, prime, claude, codex, cursor, gemini, qoder, trae.
The default is auto, which selects already detected Agent installations.
Use --with-mcp only when installing the WorkBuddy MCP adapter.
EOF
}
cleanup() {
  status=$?
  if [[ $status -ne 0 && -n "$RELEASE" && "$RELEASE" == "$DATA_ROOT"/releases/* ]]; then
    rm -rf -- "$RELEASE"
  fi
  [[ -n "$LOCK" ]] && rmdir -- "$LOCK" 2>/dev/null || true
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

while (($#)); do
  case "$1" in
    --agent) [[ $# -ge 2 ]] || { printf '%s\n' '--agent needs a value' >&2; exit 2; }; AGENTS+=("$2"); shift 2 ;;
    --prefix) [[ $# -ge 2 ]] || { printf '%s\n' '--prefix needs a value' >&2; exit 2; }; DATA_ROOT="$2"; shift 2 ;;
    --with-mcp) WITH_MCP=1; shift ;;
    --no-bin-link) BIN_LINK=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done
[[ "$DATA_ROOT" == /* ]] || { printf '%s\n' '--prefix must be an absolute path' >&2; exit 2; }
((${#AGENTS[@]})) || AGENTS=(auto)

command -v python3 >/dev/null || { printf '%s\n' 'Python 3.10+ is required.' >&2; exit 1; }
python3 -c 'import sys; raise SystemExit(sys.version_info < (3,10))' || {
  printf 'Python 3.10+ is required; found %s.\n' "$(python3 --version)" >&2; exit 1;
}
mkdir -p -- "$DATA_ROOT/releases"
LOCK="$DATA_ROOT/.install.lock"
mkdir -- "$LOCK" 2>/dev/null || { printf 'Another install is active: %s\n' "$LOCK" >&2; exit 1; }

package_version="$(python3 -c 'import pathlib,re,sys; text=pathlib.Path(sys.argv[1]).read_text(); print(re.search(r"^version = \"([^\"]+)\"", text, re.M).group(1))' "$ROOT/pyproject.toml")"
release_id="$package_version-$(date -u +%Y%m%dT%H%M%SZ)-$$"
RELEASE="$DATA_ROOT/releases/$release_id"
SKILL_COPY="$RELEASE/skill"
VENV="$RELEASE/venv"
mkdir -p -- "$RELEASE"
python3 - "$ROOT" "$SKILL_COPY" <<'PY'
import shutil, sys
source, destination = sys.argv[1:]
ignored = {'.git', '.venv', 'dist', 'build', '__pycache__', '.pytest_cache', '*.egg-info'}
def ignore(_path, names):
    return [name for name in names if name in ignored or name.endswith(('.pyc', '.egg-info'))]
shutil.copytree(source, destination, ignore=ignore)
PY

package_spec="$SKILL_COPY"
((WITH_MCP)) && package_spec="$SKILL_COPY[mcp]"
if command -v uv >/dev/null; then
  export UV_HTTP_TIMEOUT="${UV_HTTP_TIMEOUT:-120}"
  uv venv "$VENV"
  uv pip install --python "$VENV/bin/python" "$package_spec"
else
  python3 -m venv "$VENV"
  "$VENV/bin/python" -m pip install --upgrade pip
  "$VENV/bin/python" -m pip install "$package_spec"
fi
"$VENV/bin/hltv_demos" --help >/dev/null
if ((WITH_MCP)); then
  "$VENV/bin/python" -c 'import hltv_demos.mcp_server' >/dev/null
fi
[[ -f "$SKILL_COPY/SKILL.md" ]] || { printf '%s\n' 'Install validation failed: SKILL.md missing.' >&2; exit 1; }

next="$DATA_ROOT/.current.new.$$"
ln -s -- "releases/$release_id" "$next"
mv -Tf -- "$next" "$DATA_ROOT/current"
RELEASE=""  # The validated release is now active and must survive later link warnings.

agent_root() {
  case "$1" in
    prime) printf '%s\n' "$HOME/.prime/agent/skills" ;;
    claude) printf '%s\n' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills" ;;
    codex) printf '%s\n' "$HOME/.agents/skills" ;;
    cursor) printf '%s\n' "$HOME/.cursor/skills" ;;
    gemini) printf '%s\n' "$HOME/.gemini/skills" ;;
    qoder) printf '%s\n' "$HOME/.qoder/skills" ;;
    trae) printf '%s\n' "$HOME/.trae/skills" ;;
    *) return 1 ;;
  esac
}
agent_detected() {
  case "$1" in
    prime) [[ -d "$HOME/.prime/agent" ]] ;;
    claude) [[ -d "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" ]] || command -v claude >/dev/null ;;
    codex) [[ -d "$HOME/.codex" || -d "$HOME/.agents" ]] || command -v codex >/dev/null ;;
    cursor) [[ -d "$HOME/.cursor" ]] || command -v cursor >/dev/null ;;
    gemini) [[ -d "$HOME/.gemini" ]] || command -v gemini >/dev/null ;;
    qoder) [[ -d "$HOME/.qoder" ]] || command -v qoder >/dev/null ;;
    trae) [[ -d "$HOME/.trae" ]] || command -v trae >/dev/null ;;
  esac
}

selected=()
for requested in "${AGENTS[@]}"; do
  case "$requested" in
    all) selected+=(prime claude codex cursor gemini qoder trae) ;;
    auto)
      for candidate in prime claude codex cursor gemini qoder trae; do
        agent_detected "$candidate" && selected+=("$candidate") || true
      done
      ;;
    prime|claude|codex|cursor|gemini|qoder|trae) selected+=("$requested") ;;
    *) printf 'Unknown agent: %s\n' "$requested" >&2; exit 2 ;;
  esac
done

linked=0
seen='|'
for agent in "${selected[@]}"; do
  [[ "$seen" == *"|$agent|"* ]] && continue
  seen+="$agent|"
  root="$(agent_root "$agent")"
  dest="$root/hltv-demos"
  mkdir -p -- "$root"
  if [[ -e "$dest" || -L "$dest" ]]; then
    resolved="$(readlink -f -- "$dest" 2>/dev/null || true)"
    if [[ "$resolved" == "$ROOT" && ! -L "$dest" ]]; then
      printf '[%s] source skill already lives at %s; kept in place.\n' "$agent" "$dest"
      linked=1
      continue
    fi
    if [[ -L "$dest" && ( "$resolved" == "$ROOT" || "$resolved" == "$DATA_ROOT"/releases/*/skill ) ]]; then
      rm -- "$dest"
    else
      printf '[%s] refusing to replace existing path: %s\n' "$agent" "$dest" >&2
      continue
    fi
  fi
  ln -s -- "$DATA_ROOT/current/skill" "$dest"
  printf '[%s] linked: %s\n' "$agent" "$dest"
  linked=1
done

if ((BIN_LINK)); then
  bin_dir="$HOME/.local/bin"
  mkdir -p -- "$bin_dir"
  command_names=(hltv-demos)
  ((WITH_MCP)) && command_names+=(hltv-demos-mcp)
  for command_name in "${command_names[@]}"; do
    bin_dest="$bin_dir/$command_name"
    source_path="$DATA_ROOT/current/skill/scripts/$command_name"
    if [[ ! -e "$bin_dest" && ! -L "$bin_dest" ]]; then
      ln -s -- "$source_path" "$bin_dest"
      printf 'Command linked: %s\n' "$bin_dest"
    elif [[ "$(readlink -f -- "$bin_dest" 2>/dev/null || true)" != "$DATA_ROOT"/releases/*/skill/scripts/"$command_name" ]]; then
      printf 'Command path already exists; kept unchanged: %s\n' "$bin_dest" >&2
    fi
  done
fi

printf 'Installed runtime: %s/current\n' "$DATA_ROOT"
((WITH_MCP)) && printf '%s\n' 'WorkBuddy MCP adapter: installed'
printf 'Run diagnostics: %s/current/skill/scripts/doctor\n' "$DATA_ROOT"
if ((linked == 0)); then
  printf '%s\n' 'No Agent was detected. Re-run with --agent claude (or another Agent).'
fi
